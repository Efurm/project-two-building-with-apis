# Copy this file to .env and fill in real values. .env is git-ignored.

# Get it at https://www.themoviedb.org/settings/api ("API Read Access Token").
TMDB_READ_ACCESS_TOKEN=your-read-access-token-here

# Generate one with:
#   uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=your-secret-key-here

# For scripts/api_client.py: generate a token on the site's "My account" page.
MOVIELOG_API_TOKEN=your-api-token-here
# Optional; this is the default.
# MOVIELOG_API_URL=http://127.0.0.1:8000/api
